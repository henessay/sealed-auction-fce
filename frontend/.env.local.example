# Coston2 (flareTestnet, chain id 114)
NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# SealedAuction address — from config/extension.env after pre-build.sh
NEXT_PUBLIC_SEALED_AUCTION=0x057c49831762029EA82c5644ff9D426D02486EeB

# FlareTeeManager diamond (Coston2). Used by the verify panel for machine status.
NEXT_PUBLIC_FLARE_TEE_MANAGER=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE

# Extension proxy — used by Next.js API routes (server-side only).
# Local stack: http://127.0.0.1:6674 (docker maps host 6674 → proxy 6664).
EXT_PROXY_URL=http://127.0.0.1:6674
# Optional fallback tried after EXT_PROXY_URL fails.
EXT_PROXY_LOCAL_URL=http://127.0.0.1:6674

# Native fee forwarded to the TEE registry with each instruction (wei).
# Must match tools/pkg/utils InstructionFeeWei.
NEXT_PUBLIC_INSTRUCTION_FEE_WEI=1000000

# Demo ERC-721 lot token (contracts/DemoAsset721.sol) for the mint helper.
NEXT_PUBLIC_DEMO_ASSET=0x6F7640AcbdCA0dfc4817C660928d02d0B3B6011E
